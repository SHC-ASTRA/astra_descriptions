    <child
      link="core_camera_link" />
  </joint>

  <gazebo reference="core_camera_link">
    <material>
      <ambient>"0.1 0.1 0.1 1"</ambient>
      <diffuse>"0.1 0.1 0.1 1"</diffuse>
      <specular>"0.1 0.1 0.1 1"</specular>
    </material>
    <sensor name="core_camera_sensor" type="camera">
      <topic>/camera_head/image</topic>
      <update_rate>12.0</update_rate>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>1.52</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>120.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
      <camera_info_topic>/camera_head/camera_info</camera_info_topic>
      <gz_frame_id>core_camera_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- GAZEBO RAW ODOMETRY -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/model/core_rover/odometry</odom_topic>
      <odom_covariance_topic>/model/core_rover/odometry_with_covariance</odom_covariance_topic>
      <tf_topic>/model/core_rover/pose</tf_topic>
      <dimensions>2</dimensions>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
      <gaussian_noise>0</gaussian_noise>
    </plugin>
  </gazebo>

</robot>
